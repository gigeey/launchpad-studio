# Rust
/target/
frontend/src-tauri/target/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store

# Tauri-generated capability autocompletion schemas. Rebuilt from
# src-tauri/capabilities/ on every build, so a checkout does not need them.
frontend/src-tauri/gen/schemas/

# TypeScript incremental build caches. Regenerated by tsc on demand and keyed
# to one machine's absolute paths, so a checkout is better off without them.
*.tsbuildinfo

# Frontend environment files. `frontend/.env` holds the build secret that gates
# the in-app debug panel; dev/generate-build-secret.sh writes it and
# dev/README.md explains when you need one.
frontend/.env
frontend/.env.local

# Per-worktree direnv config, used to run two checkouts side by side without
# port or data-directory collisions. guide/DEVELOPING.md has the template.
.envrc

# Provider API keys — local development credentials, never committed. Copy
# providers.toml.example and fill it in; the example documents every field.
providers.toml

# Per-project runtime state the app writes into whatever repository it is
# working in: git worktrees created by the EnterWorktree tool
# (ao-engine-tools-engine/src/worktree/mod.rs) and an optional project-local
# settings.json holding hook and permission rules
# (ao-engine-tools-runner/src/hooks/config.rs). The worktree tool also drops a
# `*` .gitignore inside the directory so it self-ignores in repositories that
# have no rule for it; this entry states the same intent here rather than
# relying on that runtime side effect. A hand-written settings.json meant to
# ride with the repo would have to be force-added.
.launchpad_studio/
