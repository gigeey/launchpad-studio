{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Launchpad Studio Windows Preview",
  "identifier": "com.gigeey.launchpad-studio.windows-preview",
  "app": {
    "windows": [
      {
        "title": "Launchpad Studio Windows Preview",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "transparent": false,
        "decorations": true,
        "backgroundColor": "#151515"
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
