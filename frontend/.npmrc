# Turn the `engines` range in package.json into a hard failure.
#
# Without this, npm only prints an EBADENGINE *warning* and installs anyway,
# so an unsupported Node version surfaces much later as an opaque stack trace
# from a transitive dependency rather than as a version error. The range is
# the intersection of what vite, vitest and jsdom declare; see the Node entry
# in guide/DEVELOPING.md.
engine-strict=true
